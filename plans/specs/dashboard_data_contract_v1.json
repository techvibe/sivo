{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SivoDashboardEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "tenant_id",
    "repo_id",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "task_status_changed",
        "acceptance_result_recorded",
        "conformance_result_recorded",
        "benchmark_result_recorded",
        "policy_verdict_recorded",
        "migration_state_changed"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string" },
    "repo_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "conformance_result_recorded",
              "acceptance_result_recorded"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["metrics_snapshot"],
            "properties": {
              "metrics_snapshot": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "intent_contract_coverage",
                  "bdd_coverage_ratio"
                ],
                "properties": {
                  "intent_contract_coverage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "bdd_coverage_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
